{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "op run --env-file=.env -- vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"audit": "npm audit --omit=dev --audit-level=high",
		"spellcheck": "cspell --no-progress \"src/**/*.{ts,js,svelte,css,md}\" \"../*.md\" \"../.github/workflows/*.yml\"",
		"lint": "npm run lint:js && npm run lint:css",
		"lint:js": "eslint . --max-warnings=0",
		"lint:css": "stylelint \"src/**/*.css\" --max-warnings=0",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"ci": "npm run audit && npm run spellcheck && npm run lint && npm run check && npm run test && npm run build"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@supabase/supabase-js": "^2.97.0",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.2.0",
		"@types/dompurify": "^3.2.0",
		"@vite-pwa/sveltekit": "^1.1.0",
		"cspell": "^9.7.0",
		"eslint": "^10.1.0",
		"eslint-plugin-svelte": "^3.16.0",
		"globals": "^17.4.0",
		"stylelint": "^17.6.0",
		"stylelint-config-standard": "^40.0.0",
		"svelte": "^5.51.0",
		"svelte-check": "^4.3.6",
		"tailwindcss": "^4.2.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.57.2",
		"vite": "^7.3.1",
		"vite-plugin-pwa": "^1.2.0",
		"vitest": "^4.1.2"
	},
	"dependencies": {
		"dompurify": "^3.3.3"
	}
}
