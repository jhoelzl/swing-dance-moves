{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "op run --env-file=.env -- vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"audit": "npm audit --omit=dev --audit-level=high",
		"spellcheck": "cspell --no-progress \"src/**/*.{ts,js,svelte,css,md}\" \"../*.md\" \"../.github/workflows/*.yml\"",
		"knip": "knip",
		"lint": "npm run lint:js && npm run lint:css",
		"lint:js": "eslint . --max-warnings=0",
		"lint:css": "stylelint \"src/**/*.css\" --max-warnings=0",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"ci": "npm run audit && npm run spellcheck && npm run lint && npm run check && npm run test && npm run build"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@supabase/supabase-js": "^2.105.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.59.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.4",
		"@vite-pwa/sveltekit": "^1.1.0",
		"cspell": "^10.0.0",
		"eslint": "^10.3.0",
		"eslint-plugin-svelte": "^3.17.1",
		"globals": "^17.6.0",
		"knip": "^6.11.0",
		"stylelint": "^17.10.0",
		"stylelint-config-standard": "^40.0.0",
		"svelte": "^5.55.5",
		"svelte-check": "^4.4.7",
		"tailwindcss": "^4.2.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.1",
		"vite": "^8.0.10",
		"vitest": "^4.1.5"
	},
	"dependencies": {
		"dompurify": "^3.4.2"
	},
	"overrides": {
		"cookie": "0.7.0",
		"serialize-javascript": "7.0.5",
		"@vite-pwa/sveltekit": {
			"vite": ">=7.3.2"
		}
	}
}
