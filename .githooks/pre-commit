#!/usr/bin/env sh
set -eu

REPO_ROOT="$(git rev-parse --show-toplevel)"

echo "[pre-commit] Running staged secret scan..."
if command -v gitleaks >/dev/null 2>&1; then
	cd "$REPO_ROOT"
	gitleaks protect --staged --redact
else
	echo "[pre-commit] gitleaks not found; skipping local secret scan."
	echo "[pre-commit] Install: https://github.com/gitleaks/gitleaks"
fi

echo "[pre-commit] Running workflow lint..."
if command -v actionlint >/dev/null 2>&1; then
	cd "$REPO_ROOT"
	actionlint
else
	echo "[pre-commit] actionlint not found; skipping workflow lint."
	echo "[pre-commit] Install: https://github.com/rhysd/actionlint#installation"
fi

echo "[pre-commit] Running shell script lint..."
if command -v shellcheck >/dev/null 2>&1; then
	cd "$REPO_ROOT"
	shellcheck .githooks/pre-commit
else
	echo "[pre-commit] shellcheck not found; skipping shell lint."
	echo "[pre-commit] Install: https://www.shellcheck.net/"
fi

echo "[pre-commit] Running YAML lint..."
if command -v yamllint >/dev/null 2>&1; then
	cd "$REPO_ROOT"
	yamllint -c .yamllint.yml .github/workflows
else
	echo "[pre-commit] yamllint not found; skipping YAML lint."
	echo "[pre-commit] Install: https://yamllint.readthedocs.io/"
fi

echo "[pre-commit] Running Markdown lint..."
if command -v markdownlint >/dev/null 2>&1; then
	cd "$REPO_ROOT"
	markdownlint README.md IMPROVEMENTS.md frontend/README.md
else
	echo "[pre-commit] markdownlint not found; skipping Markdown lint."
	echo "[pre-commit] Install: https://github.com/igorshubovych/markdownlint-cli"
fi

echo "[pre-commit] Running GitHub Actions security scan..."
if command -v zizmor >/dev/null 2>&1; then
	cd "$REPO_ROOT"
	zizmor .github/workflows
else
	echo "[pre-commit] zizmor not found; skipping GitHub Actions security scan."
	echo "[pre-commit] Install: https://docs.zizmor.sh/installation/"
fi

echo "[pre-commit] Running link check..."
if command -v lychee >/dev/null 2>&1; then
	cd "$REPO_ROOT"
	lychee --no-progress README.md IMPROVEMENTS.md frontend/README.md
else
	echo "[pre-commit] lychee not found; skipping link check."
	echo "[pre-commit] Install: https://github.com/lycheeverse/lychee"
fi

echo "[pre-commit] Running dependency and dead-code check..."
cd "$REPO_ROOT/frontend"
npm run knip

echo "[pre-commit] Running frontend CI checks..."
cd "$REPO_ROOT/frontend"
npm run ci

echo "[pre-commit] All checks passed."